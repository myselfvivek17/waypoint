# Copy to .env and fill in. Leave OPENROUTER_API_KEY empty to run in mock mode.
OPENROUTER_API_KEY=
# Only free models are accepted: "openrouter/free" or any id ending in ":free".
# A comma-separated list is tried in order. openrouter/free alone picks a random free
# model, some of which ignore JSON mode; a fast JSON-capable model first is more reliable:
#   WP_LLM_MODEL=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
WP_LLM_MODEL=openrouter/free
# Set to 1 to force the deterministic mock model (tests do this).
WP_LLM_MOCK=0
# Optional: real venue photos from Foursquare Places. Leave empty to skip Foursquare silently;
# Waypoint then uses Wikimedia Commons photos of the place and labelled "similar vibe" photos from Openverse.
FOURSQUARE_API_KEY=
